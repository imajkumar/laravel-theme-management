{
    "name": "ayra/laravel-themes",
    "description": "A powerful theme management system for Laravel 12.x that helps you organize themes, layouts, assets, and widgets efficiently. Based on teepluss/theme with modern Laravel compatibility.",
    "keywords": ["laravel", "theme", "layout", "asset", "widget", "laravel12", "themes"],
    "homepage": "https://github.com/ayra/laravel-themes",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ajay Kumar",
            "email": "ajayit2020@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "opis/closure": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Ayra\\Theme\\": "src/"
        },
        "classmap": [
            "src/Exceptions.php"
        ],
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ayra\\Theme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "test:coverage-text": "phpunit --coverage-text",
        "test:coverage-clover": "phpunit --coverage-clover coverage.xml",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "security": "composer audit",
        "check": [
            "@lint",
            "@security",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ayra\\Theme\\ThemeServiceProvider"
            ],
            "aliases": {
                "Theme": "Ayra\\Theme\\Facades\\Theme"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
